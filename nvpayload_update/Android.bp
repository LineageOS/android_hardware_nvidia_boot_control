cc_binary {
    name: "nv_bootloader_payload_updater",
    srcs: ["nv_bootloader_payload_updater.cpp", "gpt/gpttegra.cpp"],
    static_executable: true,
    header_libs: ["nvidia_bootctrl_headers"],

    cflags: [
        "-Wa,--noexecstack",
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wformat=2",
        "-Wno-psabi",
        "-Wno-unused-parameter",
        "-ffunction-sections",
        "-fstack-protector-strong",
        "-fvisibility=hidden",
        "-Wno-sign-compare",
    ],
    cppflags: [
        "-Wnon-virtual-dtor",
        "-fno-strict-aliasing",
    ],
    static_libs: [
        "libbase",
        "liblog",
        "libext2_uuid",
        "libgptf",
    ],
}
